# Compose stack and service name of the Minecraft container.
# MC_STACK_NAME is set automatically via ${COMPOSE_PROJECT_NAME} in compose.yml.
# MC_SERVICE_NAME defaults to "minecraft" — only change if your service is named differently.
MC_STACK_NAME=
MC_SERVICE_NAME=minecraft

# Direct container name override — skips label-based lookup entirely.
# Only needed when running MineDash outside Docker Compose.
# MC_CONTAINER_NAME=minecraft

# bcrypt hash of the login password (cost 12)
# Generate: htpasswd -bnBC 12 "" yourpassword | tr -d ':\n'
AUTH_PASSWORD_HASH=

# Secret key for JWT signing (generate: openssl rand -hex 32)
JWT_SECRET=

# Internal listen port (default: 8080)
PORT=8080

# Optional: explicitly set the world path instead of auto-detecting from /mc-data
# WORLD_PATH=/mc-data/world

# UID and GID to assign to the world folder after upload.
# Must match what the Minecraft container runs as (itzg default: 1000).
# Override if you run itzg with a custom UID/GID (PUID/PGID env vars).
MC_UID=1000
MC_GID=1000
