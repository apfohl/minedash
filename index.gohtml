<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MineDash</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:          #0e1a0e;
      --bg-card:     #162416;
      --bg-input:    #1c2e1c;
      --border:      #2a4a2a;
      --border-bright: #3d6e3d;
      --green-dim:   #4a7a3a;
      --green:       #5fa83f;
      --green-bright:#8bc34a;
      --green-light: #b5e27a;
      --text:        #d4edba;
      --text-muted:  #7aaa5a;
      --red:         #c0392b;
      --red-dim:     #7a2520;
      --orange:      #d4801a;
      --radius:      6px;
      --font:        'JetBrains Mono', monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 64px 24px 24px;
    }

    /* ── header ── */
    header {
      width: 100%;
      max-width: 600px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }
    .logo {
      font-size: 20px;
      font-weight: 700;
      color: var(--green-bright);
      letter-spacing: 0.05em;
    }
    .logo span { color: var(--green-light); }

    /* ── card ── */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 32px;
      width: 100%;
      max-width: 600px;
    }
    .card + .card { margin-top: 16px; }
    .card-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      margin-bottom: 20px;
    }

    [hidden] { display: none !important; }
    .categories { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .category { flex: 1; padding: 10px 12px; }
    .category[aria-pressed=true] { background: var(--bg-input); border-color: var(--green); color: var(--green-light); }
    .category:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }
    .backup-summary { color: var(--text-muted); font-size: 12px; margin-bottom: 20px; }
    .backup-list { list-style: none; }
    .backup-item { padding: 16px 0; border-top: 1px solid var(--border); }
    .backup-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .backup-date { font-weight: 600; color: var(--green-light); }
    .backup-size { font-size: 12px; color: var(--text-muted); }
    .backup-name { font-size: 12px; color: var(--text-muted); margin-top: 8px; overflow-wrap: anywhere; }
    .backup-newest { font-size: 10px; color: var(--green-bright); border: 1px solid var(--green-dim); border-radius: 999px; padding: 3px 8px; }
    @media (max-width: 480px) {
      body { padding: 64px 16px 16px; }
      .card { padding: 24px 20px; }
      .category { font-size: 11px; }
    }

    /* ── login form ── */
    #login-view { text-align: center; }
    #login-view .logo { font-size: 26px; margin-bottom: 28px; display: block; }
    .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; text-align: left; }
    .field label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; }
    .field input {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      padding: 10px 14px;
      outline: none;
      transition: border-color 0.15s;
    }
    .field input:focus { border-color: var(--green); }

    /* ── buttons ── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-family: var(--font);
      font-size: 13px;
      font-weight: 600;
      padding: 10px 20px;
      border: 1px solid transparent;
      border-radius: var(--radius);
      cursor: pointer;
      transition: opacity 0.15s, background 0.15s, border-color 0.15s;
      text-decoration: none;
    }
    .btn:disabled { opacity: 0.38; cursor: not-allowed; }
    .btn-primary {
      background: var(--green);
      border-color: var(--green-bright);
      color: #0e1a0e;
      width: 100%;
    }
    .btn-primary:hover:not(:disabled) { background: var(--green-bright); }
    .btn-ghost {
      background: transparent;
      border-color: var(--border-bright);
      color: var(--text);
    }
    .btn-ghost:hover:not(:disabled) { border-color: var(--green); color: var(--green-bright); }
    .btn-danger {
      background: transparent;
      border-color: var(--red-dim);
      color: #e07060;
    }
    .btn-danger:hover:not(:disabled) { border-color: var(--red); color: #ff8070; }
    .btn-sm { padding: 7px 14px; font-size: 12px; }

    /* ── status badge ── */
    .status-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid transparent;
    }
    .badge::before {
      content: '';
      width: 8px; height: 8px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }
    .badge-running   { color: var(--green-bright); border-color: var(--green-dim); background: rgba(95,168,63,0.1);   }
    .badge-stopped   { color: #a0a0a0;             border-color: #3a3a3a;         background: rgba(80,80,80,0.1);    }
    .badge-starting  { color: var(--orange);        border-color: #7a4a10;         background: rgba(212,128,26,0.1);  }
    .badge-stopping  { color: var(--orange);        border-color: #7a4a10;         background: rgba(212,128,26,0.1);  }
    .badge-unhealthy { color: var(--red);           border-color: var(--red-dim);  background: rgba(192,57,43,0.1);   }
    .badge-unknown   { color: #a0a0a0;              border-color: #3a3a3a;         background: rgba(80,80,80,0.1);    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }
    .badge-starting::before,
    .badge-stopping::before,
    .badge-unhealthy::before { animation: pulse 1.2s ease-in-out infinite; }

    /* ── controls ── */
    .btn-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .btn-row .btn { flex: 1; min-width: 120px; }

    /* ── world section ── */
    .world-row {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .world-row .btn { flex: 1; min-width: 160px; }

    .upload-area {
      margin-top: 16px;
      border: 1px dashed var(--border-bright);
      border-radius: var(--radius);
      padding: 20px;
      text-align: center;
      transition: border-color 0.15s, background 0.15s;
      cursor: pointer;
      position: relative;
    }
    .upload-area.drag-over {
      border-color: var(--green);
      background: rgba(95,168,63,0.06);
    }
    .upload-area input[type=file] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .upload-area p { color: var(--text-muted); font-size: 13px; pointer-events: none; }
    .upload-area .filename { color: var(--green-bright); margin-top: 6px; font-size: 13px; }

    .upload-submit { margin-top: 12px; width: 100%; }

    /* ── feedback / error ── */
    .feedback {
      margin-top: 12px;
      padding: 10px 14px;
      border-radius: var(--radius);
      font-size: 13px;
      display: none;
    }
    .feedback.show { display: block; }
    .feedback.ok  { background: rgba(95,168,63,0.12); border: 1px solid var(--green-dim); color: var(--green-light); }
    .feedback.err { background: rgba(192,57,43,0.12); border: 1px solid var(--red-dim);   color: #f08070; }

    /* ── logout link ── */
    .logout-btn {
      background: none; border: none; cursor: pointer;
      font-family: var(--font); font-size: 12px;
      color: var(--text-muted);
      text-decoration: underline;
    }
    .logout-btn:hover { color: var(--text); }

    /* ── error message under login ── */
    #login-error {
      color: #f08070;
      font-size: 13px;
      margin-top: 10px;
      min-height: 18px;
    }

    /* ── hint text ── */
    .hint { font-size: 12px; color: var(--text-muted); margin-top: 8px; }
  </style>
</head>
<body>

<!-- ════════════════ LOGIN VIEW ════════════════ -->
<div id="login-view">
  <a class="logo" href="/" style="text-decoration:none">Mine<span>Dash</span></a>
  <div class="card">
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" placeholder="Enter password" autocomplete="current-password" />
    </div>
    <button class="btn btn-primary" id="login-btn" onclick="doLogin()">Login</button>
    <div id="login-error"></div>
  </div>
</div>

<!-- ════════════════ DASHBOARD VIEW ════════════════ -->
<div id="dashboard-view" style="display:none; width:100%; max-width:600px;">
  <header>
    <a class="logo" href="/" style="text-decoration:none">Mine<span>Dash</span></a>
    <button class="logout-btn" onclick="doLogout()">logout</button>
  </header>

  <nav class="categories" aria-label="Dashboard categories">
    <button class="btn btn-ghost category" id="category-status" aria-pressed="true" aria-controls="panel-status" onclick="showCategory('status')">Status</button>
    <button class="btn btn-ghost category" id="category-world" aria-pressed="false" aria-controls="panel-world" onclick="showCategory('world')">World Management</button>
    <button class="btn btn-ghost category" id="category-backups" aria-pressed="false" aria-controls="panel-backups" onclick="showCategory('backups')" hidden>Backups</button>
  </nav>

  <!-- Status card -->
  <section class="card" id="panel-status" aria-labelledby="category-status">
    <div class="card-title">Server Status</div>
    <div class="status-row">
      <span id="status-badge" class="badge badge-unknown">unknown</span>
    </div>
    <div class="btn-row">
      <button class="btn btn-ghost" id="btn-start"   onclick="doAction('start')">Start</button>
      <button class="btn btn-ghost" id="btn-restart" onclick="doAction('restart')">Restart</button>
      <button class="btn btn-danger" id="btn-stop"   onclick="doAction('stop')">Stop</button>
    </div>
    <div id="action-feedback" class="feedback"></div>
  </section>

  <!-- World card -->
  <section class="card" id="panel-world" aria-labelledby="category-world" hidden>
    <div class="card-title">World Management</div>
    <div class="world-row">
      <button class="btn btn-ghost" id="btn-download" onclick="doDownload()">Download World</button>
    </div>
    <p class="hint" id="world-hint"></p>

    <!-- Upload -->
    <div style="margin-top: 20px;">
      <div class="card-title">Upload World</div>
      <div class="upload-area" id="upload-area">
        <input type="file" id="world-file" accept=".zip" onchange="onFileSelect(this)" />
        <p>Drop a world ZIP here or click to select</p>
        <div class="filename" id="selected-filename"></div>
      </div>
      <button class="btn btn-primary upload-submit" id="btn-upload" onclick="doUpload()" disabled>Upload &amp; Replace World</button>
      <div id="upload-feedback" class="feedback"></div>
    </div>
  </section>

  <section class="card" id="panel-backups" aria-labelledby="category-backups" hidden>
    <div class="card-title">Available Backups</div>
    <p class="backup-summary" id="backup-summary"></p>
    <div id="backup-feedback" class="feedback" role="status"></div>
    <ul class="backup-list" id="backup-list"></ul>
    <p class="hint">Dates and times are shown as recorded in the backup filenames.</p>
  </section>
</div>

<script>
  // ── state ──────────────────────────────────────────────
  let currentCategory = 'status';
  let backupsRefreshing = false;
  let lastBackupRefresh = 0;
  let currentStatus = 'unknown';
  let polling       = false;   // true while an action/upload is in flight
  let pollInterval  = null;

  // ── init ───────────────────────────────────────────────
  window.addEventListener('DOMContentLoaded', () => {
    {{if .Authenticated}}
    showDashboard();
    refreshStatus();
    {{else}}
    showLogin();
    {{end}}

    // Drag-and-drop styling
    const area = document.getElementById('upload-area');
    area.addEventListener('dragover',  e => { e.preventDefault(); area.classList.add('drag-over'); });
    area.addEventListener('dragleave', () => area.classList.remove('drag-over'));
    area.addEventListener('drop', e => {
      e.preventDefault();
      area.classList.remove('drag-over');
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        document.getElementById('world-file').files = files;
        onFileSelect(document.getElementById('world-file'));
      }
    });

    // Login on Enter key
    document.getElementById('password').addEventListener('keydown', e => {
      if (e.key === 'Enter') doLogin();
    });
  });

  // ── polling ────────────────────────────────────────────
  function startPolling() {
    if (pollInterval) return;
    pollInterval = setInterval(() => {
      if (polling) return;
      refreshStatus();
      if (Date.now() - lastBackupRefresh >= 30000) refreshBackups();
    }, 3000);
  }

  function stopPolling() {
    clearInterval(pollInterval);
    pollInterval = null;
  }

  // ── views ──────────────────────────────────────────────
  function showLogin() {
    stopPolling();
    document.getElementById('login-view').style.display = '';
    document.getElementById('dashboard-view').style.display = 'none';
  }
  function showDashboard() {
    document.getElementById('login-view').style.display = 'none';
    document.getElementById('dashboard-view').style.display = '';
    showCategory('status');
    refreshBackups();
    startPolling();
  }

  function showCategory(category) {
    if (category === 'backups' && document.getElementById('category-backups').hidden) return;
    currentCategory = category;
    ['status', 'world', 'backups'].forEach(name => {
      document.getElementById('category-' + name).setAttribute('aria-pressed', String(name === category));
      document.getElementById('panel-' + name).hidden = name !== category;
    });
  }

  function formatSize(bytes) {
    const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
    let unit = 0;
    while (bytes >= 1024 && unit < units.length - 1) { bytes /= 1024; unit++; }
    return bytes.toLocaleString(undefined, { maximumFractionDigits: unit ? 2 : 0 }) + ' ' + units[unit];
  }

  async function refreshBackups() {
    if (backupsRefreshing) return;
    backupsRefreshing = true;
    lastBackupRefresh = Date.now();
    const feedback = document.getElementById('backup-feedback');
    try {
      const response = await fetch('/api/backups');
      if (response.status === 401) { showLogin(); return; }
      if (!response.ok) throw new Error('Unavailable');
      const data = await response.json();
      const available = data.backups.length > 0;
      const button = document.getElementById('category-backups');
      if (!available && currentCategory === 'backups') {
        showCategory('status');
        button.hidden = true;
        document.getElementById('category-status').focus();
      } else {
        button.hidden = !available;
      }
      const list = document.getElementById('backup-list');
      list.replaceChildren();
      let total = 0;
      data.backups.forEach((backup, index) => {
        total += backup.size;
        const item = document.createElement('li');
        item.className = 'backup-item';
        const heading = document.createElement('div');
        heading.className = 'backup-heading';
        const date = document.createElement('span');
        date.className = 'backup-date';
        const [day, time] = backup.timestamp.split('T');
        date.textContent = day + ' · ' + time.replaceAll('-', ':');
        heading.append(date);
        if (index === 0) {
          const newest = document.createElement('span');
          newest.className = 'backup-newest';
          newest.textContent = 'Newest';
          heading.append(newest);
        }
        const size = document.createElement('span');
        size.className = 'backup-size';
        size.textContent = formatSize(backup.size);
        heading.append(size);
        const name = document.createElement('p');
        name.className = 'backup-name';
        name.textContent = backup.name;
        const download = document.createElement('a');
        download.className = 'btn btn-ghost btn-sm';
        download.href = '/api/backups/' + encodeURIComponent(backup.name) + '/download';
        download.setAttribute('download', backup.name);
        download.setAttribute('aria-label', 'Download ' + backup.name);
        download.textContent = 'Download';
        heading.append(download);
        item.append(heading, name);
        list.append(item);
      });
      document.getElementById('backup-summary').textContent = data.backups.length +
        (data.backups.length === 1 ? ' backup' : ' backups') + ' · ' + formatSize(total) + ' total';
      setFeedback(feedback, '', '');
    } catch {
      setFeedback(feedback, 'err', 'Could not refresh backups. The list may be out of date. Retrying automatically.');
    } finally {
      backupsRefreshing = false;
    }
  }

  // ── login ──────────────────────────────────────────────
  async function doLogin() {
    const pw = document.getElementById('password').value;
    const errEl = document.getElementById('login-error');
    errEl.textContent = '';
    if (!pw) { errEl.textContent = 'Password is required.'; return; }

    const btn = document.getElementById('login-btn');
    btn.disabled = true;
    btn.textContent = 'Logging in…';

    try {
      const r = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw }),
      });
      if (!r.ok) {
        const d = await r.json().catch(() => ({}));
        errEl.textContent = d.error || 'Login failed.';
        return;
      }
      document.getElementById('password').value = '';
      window.location.href = "/dashboard";
    } catch {
      errEl.textContent = 'Network error. Please try again.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Login';
    }
  }

  // ── logout ─────────────────────────────────────────────
  async function doLogout() {
    await fetch('/logout', { method: 'POST' }).catch(() => {});
    window.location.href = "/";
  }

  // ── status ─────────────────────────────────────────────
  async function refreshStatus() {
    try {
      const r = await fetch('/api/status');
      if (r.status === 401) { showLogin(); return; }
      const d = await r.json();
      applyStatus(d.status);
    } catch {
      applyStatus('unknown');
    }
  }

  function applyStatus(s) {
    currentStatus = s;
    const badge = document.getElementById('status-badge');
    badge.className = 'badge badge-' + s;
    badge.textContent = s;

    const canStart   = s === 'stopped';
    const canStop    = s === 'running' || s === 'starting' || s === 'unhealthy';
    const canRestart = s === 'running' || s === 'unhealthy';
    const canWorld   = s === 'stopped';

    document.getElementById('btn-start').disabled    = !canStart;
    document.getElementById('btn-stop').disabled     = !canStop;
    document.getElementById('btn-restart').disabled  = !canRestart;
    document.getElementById('btn-download').disabled = !canWorld;
    document.getElementById('btn-upload').disabled   = !canWorld || !hasFile();

    const hint = document.getElementById('world-hint');
    hint.textContent = canWorld ? '' : 'Stop the server before downloading or uploading a world.';
  }

  // ── server actions ─────────────────────────────────────
  async function doAction(action) {
    const fb = document.getElementById('action-feedback');
    setFeedback(fb, '', '');
    polling = true;

    // Disable all action buttons during the request
    ['btn-start','btn-stop','btn-restart'].forEach(id =>
      document.getElementById(id).disabled = true);

    try {
      const r = await fetch('/api/' + action, { method: 'POST' });
      if (r.status === 401) { showLogin(); return; }
      const d = await r.json();
      if (!r.ok) {
        setFeedback(fb, 'err', d.error || 'Action failed.');
      } else {
        setFeedback(fb, 'ok', capitalize(action) + ' successful.');
      }
    } catch {
      setFeedback(fb, 'err', 'Network error. Please try again.');
    } finally {
      polling = false;
      await refreshStatus();
    }
  }

  // ── world download ─────────────────────────────────────
  function doDownload() {
    window.location.href = '/api/world/download';
  }

  // ── world upload ───────────────────────────────────────
  function onFileSelect(input) {
    const el = document.getElementById('selected-filename');
    if (input.files && input.files[0]) {
      el.textContent = input.files[0].name;
      document.getElementById('btn-upload').disabled =
        currentStatus === 'running' || currentStatus === 'starting' || currentStatus === 'stopping';
    } else {
      el.textContent = '';
      document.getElementById('btn-upload').disabled = true;
    }
  }

  function hasFile() {
    const f = document.getElementById('world-file');
    return f && f.files && f.files.length > 0;
  }

  async function doUpload() {
    const fb = document.getElementById('upload-feedback');
    setFeedback(fb, '', '');

    const fileInput = document.getElementById('world-file');
    if (!fileInput.files || fileInput.files.length === 0) {
      setFeedback(fb, 'err', 'No file selected.');
      return;
    }

    const btn = document.getElementById('btn-upload');
    btn.disabled = true;
    btn.textContent = 'Uploading…';
    polling = true;

    const form = new FormData();
    form.append('world', fileInput.files[0]);

    try {
      const r = await fetch('/api/world/upload', { method: 'POST', body: form });
      if (r.status === 401) { showLogin(); return; }
      const d = await r.json();
      if (!r.ok) {
        setFeedback(fb, 'err', d.error || 'Upload failed.');
      } else {
        setFeedback(fb, 'ok', 'World uploaded and replaced successfully.');
        fileInput.value = '';
        document.getElementById('selected-filename').textContent = '';
      }
    } catch {
      setFeedback(fb, 'err', 'Network error. Please try again.');
    } finally {
      polling = false;
      btn.textContent = 'Upload & Replace World';
      await refreshStatus();
    }
  }

  // ── helpers ────────────────────────────────────────────
  function setFeedback(el, type, msg) {
    el.className = 'feedback' + (type ? ' show ' + type : '');
    el.textContent = msg;
  }
  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }
</script>
</body>
</html>
